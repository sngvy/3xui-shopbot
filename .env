# ---------------------------------------------------------------------------
# Telegram: прокси для запросов бота к Telegram API (aiogram, AiohttpSession).
# Панели 3X-UI, платёжки и вебхуки через него не ходят.
# Формат: socks5://логин:пароль@хост:порт
# ---------------------------------------------------------------------------
#PROXY_URL=socks5://KnaIIreJsm:F6yAqvEeRD@nuxt-vless.duckdns.org:48602
PROXY_URL=socks5://DZyVUDaScJ:KqcRTlUC3w@nuxt-balancer.duckdns.org:41635

# Системный прокси для остальных исходящих запросов. Держать закомментированным:
# если включить, через него пойдут и запросы к панелям 3X-UI (py3xui/requests
# учитывают эту переменную), что замедлит их и может сломать авторизацию.
#HTTPS_PROXY=socks5h://DZyVUDaScJ:KqcRTlUC3w@nuxt-balancer.duckdns.org:41635

# ---------------------------------------------------------------------------
# Ссылки подписки
# ---------------------------------------------------------------------------
# Префикс редирект-страницы для кнопок «Открыть в Happ / FlClashX / INCY».
# К нему дописывается base64 deep-link приложения (webhook_server/app.py).
REDIR_URL="https://frdm-central.duckdns.org/redir?url="

# ---------------------------------------------------------------------------
# Тест скорости серверов
# ---------------------------------------------------------------------------
# Метод замера по SSH: 1 — консольный Ookla speedtest CLI, 0 — iperf3 до
# публичного сервера (IPERF3_SERVER_HOST). Читается при каждом запуске замера.
USE_OOKLA_SPEEDTEST=0

# 1 — тест скорости открывается как Telegram Mini App (страница /speed на
# WORKER_DOMAIN), а плановый speedtest шедулера отключается.
# 0 или пусто — обычная кнопка с callback и плановые замеры.
USE_WEBAPP_SPEEDTEST=1

# Домен, где отдаётся сам бот/Flask-сервер (страницы /speed, /mon, /redir).
# Нужен для Mini App; без него при USE_WEBAPP_SPEEDTEST=1 кнопка откатится на callback.
WORKER_DOMAIN=frdm-central.duckdns.org

# ---------------------------------------------------------------------------
# Служебные email клиентов в панели 3X-UI
# ---------------------------------------------------------------------------
# Домен в email клиентов (user_1@snowyservices_bot). Используется для создания,
# поиска клиентов и подсчёта онлайна. Нельзя менять без миграции: по нему бот
# отличает своих клиентов от чужих и удаляет «сирот».
EMAIL_DOMAIN=snowyservices_bot

# Прежние значения EMAIL_DOMAIN через запятую. Клиенты на этих доменах
# шедулер переводит на актуальный домен. Пусто — ничего не нормализуется.
LEGACY_EMAIL_DOMAINS=bot.local

# ---------------------------------------------------------------------------
# Скорость работы с панелями 3X-UI (все необязательные; читаются при старте)
# ---------------------------------------------------------------------------
# Пауза в секундах между созданием/обновлением клонов при покупке и продлении.
XUI_REPLICATION_PAUSE=0

# Множитель пауз шедулера между мутациями панели.
XUI_SCHEDULER_PAUSE_FACTOR=0.2

# Таймаут установки соединения с панелью, секунды.
XUI_HTTP_CONNECT_TIMEOUT=10

# Таймаут ожидания ответа панели, секунды.
XUI_HTTP_READ_TIMEOUT=20

# Размер пула keep-alive соединений к панелям (переиспользование TCP+TLS
# вместо нового соединения на каждый запрос).
XUI_HTTP_POOL_SIZE=16

# Число потоков для обращений к панелям. Выделенный пул, чтобы долгие операции
# с панелями не блокировали короткие вызовы БД.
XUI_POOL_SIZE=16

# ---------------------------------------------------------------------------
# Обслуживание БД
# ---------------------------------------------------------------------------
# Интервал в днях
DB_MAINTENANCE_INTERVAL_DAYS=1

# Час начала окна обслуживания по времени контейнера
DB_MAINTENANCE_HOUR=4
