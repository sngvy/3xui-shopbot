# ---------------------------------------------------------------------------
# Telegram: прокси для запросов бота к Telegram API (aiogram, AiohttpSession).
# Панели 3X-UI, платёжки и вебхуки через него не ходят.
# Формат: socks5://логин:пароль@хост:порт
# ---------------------------------------------------------------------------
#PROXY_URL=socks5://KnaIIreJsm:F6yAqvEeRD@nuxt-vless.duckdns.org:48602
PROXY_URL=socks5://DZyVUDaScJ:KqcRTlUC3w@nuxt-balancer.duckdns.org:41635

# Системный прокси для остальных исходящих запросов. Держать закомментированным:
# если включить, через него пойдут и запросы к панелям 3X-UI (py3xui/requests
# учитывают эту переменную), что замедлит их и может сломать авторизацию.
#HTTPS_PROXY=socks5h://DZyVUDaScJ:KqcRTlUC3w@nuxt-balancer.duckdns.org:41635

# ---------------------------------------------------------------------------
# Ссылки подписки
# ---------------------------------------------------------------------------
# Префикс редирект-страницы для кнопок «Открыть в Happ / FlClashX / INCY».
# К нему дописывается base64 deep-link приложения (webhook_server/app.py).
REDIR_URL="https://frdm-central.duckdns.org/redir?url="

# ---------------------------------------------------------------------------
# Тест скорости серверов
# ---------------------------------------------------------------------------
# Метод замера по SSH: 1 — консольный Ookla speedtest CLI, 0 — iperf3 до
# публичного сервера (IPERF3_SERVER_HOST). Читается при каждом запуске замера.
USE_OOKLA_SPEEDTEST=0

# 1 — тест скорости открывается как Telegram Mini App (страница /speed на
# WORKER_DOMAIN), а плановый speedtest шедулера отключается.
# 0 или пусто — обычная кнопка с callback и плановые замеры.
USE_WEBAPP_SPEEDTEST=1

# Домен, где отдаётся сам бот/Flask-сервер (страницы /speed, /mon, /redir).
# Нужен для Mini App; без него при USE_WEBAPP_SPEEDTEST=1 кнопка откатится на callback.
WORKER_DOMAIN=frdm-central.duckdns.org

# Плановый тест скорости: интервал между прогонами, секунды. Не действует
# при USE_WEBAPP_SPEEDTEST=1 — плановые замеры отключены.
SPEEDTEST_INTERVAL_SECONDS=86400

# iperf3 (при USE_OOKLA_SPEEDTEST=0): публичный сервер и диапазон портов.
IPERF3_SERVER_HOST=iperf3.moji.fr
IPERF3_SERVER_PORT=5200-5240

# Длительность одного замера iperf3 (отдельно загрузка и отдача), секунды.
IPERF3_DURATION=10

# Попыток замера скорости и пауза между ними, секунды.
SPEEDTEST_RETRIES=3
SPEEDTEST_RETRY_DELAY=5

# ---------------------------------------------------------------------------
# Служебные email клиентов в панели 3X-UI
# ---------------------------------------------------------------------------
# Домен в email клиентов (user_1@snowyservices_bot). Используется для создания,
# поиска клиентов и подсчёта онлайна. Нельзя менять без миграции: по нему бот
# отличает своих клиентов от чужих и удаляет «сирот».
EMAIL_DOMAIN=snowyservices_bot

# Прежние значения EMAIL_DOMAIN через запятую. Клиенты на этих доменах
# шедулер переводит на актуальный домен. Пусто — ничего не нормализуется.
LEGACY_EMAIL_DOMAINS=bot.local

# ---------------------------------------------------------------------------
# Скорость работы с панелями 3X-UI (все необязательные; читаются при старте)
# ---------------------------------------------------------------------------
# Пауза в секундах между созданием/обновлением клонов при покупке и продлении.
XUI_REPLICATION_PAUSE=0

# Множитель пауз шедулера между мутациями панели.
XUI_SCHEDULER_PAUSE_FACTOR=0.2

# Таймаут установки соединения с панелью, секунды.
XUI_HTTP_CONNECT_TIMEOUT=10

# Таймаут ожидания ответа панели, секунды.
XUI_HTTP_READ_TIMEOUT=20

# Размер пула keep-alive соединений к панелям (переиспользование TCP+TLS
# вместо нового соединения на каждый запрос).
XUI_HTTP_POOL_SIZE=16

# Число потоков для обращений к панелям. Выделенный пул, чтобы долгие операции
# с панелями не блокировали короткие вызовы БД.
XUI_POOL_SIZE=16

# Время жизни закэшированной сессии панели, секунды.
XUI_SESSION_CACHE_TTL_SECONDS=1500

# Попыток запроса при пустом ответе панели (в т. ч. создание клиентов) и
# базовая пауза между ними, секунды; растёт с каждой попыткой.
XUI_CALL_RETRIES=3
XUI_CALL_RETRY_DELAY=1.5

# ---------------------------------------------------------------------------
# Обслуживание БД
# ---------------------------------------------------------------------------
# Как часто выполнять REINDEX + VACUUM, дней. 0 — выключить.
DB_MAINTENANCE_INTERVAL_DAYS=1

# Час начала окна обслуживания (окно 2 часа) по времени контейнера.
DB_MAINTENANCE_HOUR=4

# ---------------------------------------------------------------------------
# Разрыв циклов нормализации номеров клонов
# ---------------------------------------------------------------------------
# 1 — шедулер разрывает циклы переименований клонов через временное имя,
# 0 — выключить.
XUI_BREAK_RENAME_CYCLES=1

# ---------------------------------------------------------------------------
# Отчёт «Потребление WL»
# ---------------------------------------------------------------------------
# Клиентов на странице (1–10).
WL_REPORT_PAGE_SIZE=5

# Сколько самых «тяжёлых» клиентов попадает в отчёт.
WL_REPORT_MAX_ITEMS=30

# Сколько секунд листать страницы без повторного опроса панелей.
WL_REPORT_CACHE_TTL_SECONDS=1800

# ---------------------------------------------------------------------------
# Антифлуд основного бота (корзина токенов на пользователя)
# ---------------------------------------------------------------------------
# Скорость пополнения корзины, событий в секунду. Администраторы не
# ограничиваются.
THROTTLE_RATE=2.0

# Размер корзины: сколько событий подряд пропускается без паузы.
THROTTLE_BURST=6

# Минимальная пауза между повторами «тяжёлой» кнопки (панели, платежи), секунды.
THROTTLE_HEAVY_COOLDOWN=1.5

# Как часто показывать уведомление об ограничении, секунды.
THROTTLE_NOTICE_INTERVAL=3.0

# Антифлуд бота поддержки
SUPPORT_THROTTLE_RATE=1.0
SUPPORT_THROTTLE_BURST=10
SUPPORT_THROTTLE_NOTICE_INTERVAL=10.0

# ---------------------------------------------------------------------------
# Алерты об аномальном трафике
# ---------------------------------------------------------------------------
# Порог объёма за один интервал проверки, МБ (разовые тяжёлые закачки).
TRAFFIC_THRESHOLD_MB=6000

# Порог скорости, Мбит/с (стабильная «полка» — роутеры, ПК, торренты).
SPEED_THRESHOLD_MBPS=110.0

# Сколько проверок подряд скорость выше порога до алерта.
STRIKE_THRESHOLD=3

# Предупреждение пользователю (владельцу подписки) об аномальном трафике.
# Шлётся, если в интервале была активность минимум у стольких email'ов подписки
# (мастер + клоны): при аномалии трафика — вместе с алертом админу, без аномалии — см.
# TRAFFIC_USER_ALERT_SHARING. 0 — не предупреждать пользователей вообще.
TRAFFIC_USER_ALERT_MIN_ACTIVE=11

# 1 — предупреждать пользователя и без аномалии трафика, если активных email'ов
# подписки >= TRAFFIC_USER_ALERT_MIN_ACTIVE (признак шеринга). 0 — только при аномалии.
TRAFFIC_USER_ALERT_SHARING=1

# Защита шеринга от ложных срабатываний (например, пинг подписки в клиенте даёт килобайты
# на каждом email): email считается активным, только если за интервал его трафик вырос минимум
# на столько КБ. 0 — любой рост трафика.
TRAFFIC_ACTIVE_MIN_KB=1024

# Сколько проверок подряд условие шеринга должно держаться до предупреждения
# (1 проверка = SCHEDULER_CHECK_INTERVAL_SECONDS, по умолчанию 5 мин). Разовые всплески не считаются.
TRAFFIC_USER_ALERT_SHARING_CHECKS=1
# Шеринг подтверждается числом уникальных IP клиента за окно (данные панели clientIps; нужен
# limitIp > 0 у клиентов). Меньше этого числа IP — предупреждение не уходит. 0 — не проверять IP.
TRAFFIC_USER_ALERT_MIN_IPS=11
TRAFFIC_USER_ALERT_IP_WINDOW_MIN=5

# Лимит IP (limitIp в 3x-ui), с которым создаются новые ключи. 0 — без лимита.
CLIENT_LIMIT_IP=10

# Пауза между повторными предупреждениями одному пользователю, часов (1–168).
# Хранится в памяти: после перезапуска бота отсчёт начинается заново.
TRAFFIC_USER_ALERT_COOLDOWN_HOURS=6

# ---------------------------------------------------------------------------
# Подписки: уведомления и grace-период
# ---------------------------------------------------------------------------
# За сколько часов до окончания слать напоминание (через запятую).
# Окно — последний час перед каждой отметкой.
NOTIFY_BEFORE_HOURS=72,48,24,1

# Дней после окончания до физического удаления ключа (до этого — grace).
EXPIRED_KEY_GRACE_DAYS=5

# Лимит трафика grace-клиента («Подписка истекла»), ГБ.
GRACE_TRAFFIC_GB=1

# Пауза до удаления старого ключа при переносе на другой сервер, секунды.
OLD_HOST_DELETE_DELAY_SECONDS=300

# ---------------------------------------------------------------------------
# Интервалы и нагрузка шедулера
# ---------------------------------------------------------------------------
# Период основного цикла, секунды. От него считаются Мбит/с в алертах и
# в отчёте WL.
SCHEDULER_CHECK_INTERVAL_SECONDS=300

# Чистка просроченных ключей, секунды.
EXPIRED_CLEANUP_INTERVAL_SECONDS=1800

# Принудительная сверка клонов с панелью, даже если ключи не менялись, секунды.
FULL_RECONCILE_INTERVAL_SECONDS=1800

# Поиск «сирот» (клиентов на панели без ключа в БД, тяжёлый обход), секунды.
ORPHAN_SWEEP_INTERVAL_SECONDS=86400

# Сбор метрик ресурсов серверов, секунды.
METRICS_INTERVAL_SECONDS=300

# Сколько просроченных ключей удалять за один проход.
MAX_EXPIRED_KEYS_PER_CYCLE=5

# Сколько хостов обходить параллельно.
HOST_SYNC_CONCURRENCY=3

# ---------------------------------------------------------------------------
# SSH к серверам (метрики, тест скорости)
# ---------------------------------------------------------------------------
# Таймаут подключения и команд, секунды.
SSH_TIMEOUT_SECONDS=30

# Сколько замеров скорости по SSH идёт одновременно.
SSH_POOL_SIZE=4

# ---------------------------------------------------------------------------
# Бэкапы
# ---------------------------------------------------------------------------
# Сколько последних архивов хранить. Интервал бэкапов задаётся в веб-панели.
BACKUP_KEEP_COUNT=7

# ---------------------------------------------------------------------------
# Веб-панель
# ---------------------------------------------------------------------------
# Ключ подписи сессий. Без него при каждом старте генерируется новый,
# и все входы в панель слетают. Сгенерировать: openssl rand -hex 32
#SHOPBOT_SECRET_KEY=

# 1 — cookie только по HTTPS, 0 — разрешить по HTTP.
SHOPBOT_COOKIE_SECURE=1

# ---------------------------------------------------------------------------
# Внешний чёрный список (ban-vpn)
# ---------------------------------------------------------------------------
# 1 — шедулер периодически сверяет пользователей с внешним списком и банит
# совпадения, 0 — выключить. Читается при старте.
BLACKLIST_ENABLED=1

# Ссылка на сырой файл списка (только https). Формат: «Telegram ID # причина»,
# по одному ID в строке.
BLACKLIST_GITHUB_URL=https://raw.githubusercontent.com/Blin4ickUSE/ban-vpn/refs/heads/main/blacklist.txt

# Как часто скачивать и применять список, часов (от 0.25). Автор списка
# рекомендует раз в час.
BLACKLIST_UPDATE_INTERVAL_HOURS=1

# 1 — администраторов бота по списку не банить никогда.
BLACKLIST_IGNORE_ADMINS=1

# 1 — если ID пропал из списка, снять бан, выставленный по списку. Ручные баны
# не снимаются. 0 — снимать только вручную.
BLACKLIST_AUTO_UNBAN=1

# Защита от испорченного списка: если за один проход нужно забанить больше
# стольких пользователей, баны не применяются, а админу уходит алерт. 0 — без лимита.
BLACKLIST_MAX_BANS_PER_RUN=0
